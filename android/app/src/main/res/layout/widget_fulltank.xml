<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <!-- Header: App Name & Refresh -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="⛽ פוול טנק • קורולה GLI"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_refresh_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="🔄"
            android:textSize="14sp"
            android:padding="2dp" />
    </RelativeLayout>

    <!-- Fuel Gauge & Level Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/widget_fuel_gauge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🟩🟩🟩🟩🟩🟩🟩🟩🟩"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_fuel_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="46.5L (93%)"
            android:textColor="#10B981"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Range & Odometer Subtitle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_range_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🛣️ טווח: ~662 ק&quot;מ"
            android:textColor="#9CA3AF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_odo_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚗 162,089 ק&quot;מ"
            android:textColor="#E5E7EB"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Quick Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/widget_btn_plus10"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_btn_bg"
            android:text="+10 ק&quot;מ"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/widget_btn_plus25"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_btn_bg"
            android:text="+25 ק&quot;מ"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/widget_btn_refuel"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1.2"
            android:background="@drawable/widget_btn_accent_bg"
            android:text="⛽ פול (100%)"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
